# Copy to .env for Docker Compose. Do not commit your actual .env.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_PASSWORD=replace-with-a-separate-random-password
# Outside Docker set DATABASE_URL to your PostgreSQL connection URI.
# EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD / DEFAULT_FROM_EMAIL
